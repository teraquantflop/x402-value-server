# ── Server (safe to set on Railway — public values only) ─────────────────────
PORT=4021
NODE_ENV=development

# Receiving wallets (public addresses only — NEVER put private keys on the server)
# Primary: EVM 0x… or Solana base58. Used as payTo for that chain family.
PAY_TO_ADDRESS=DCi9X5mmacNGLeJvCw9fdWgX3G8V4QquDn4EuXATkcYr

# Explicit receivers when enabling both Solana and Base (recommended production):
# PAY_TO_SVM_ADDRESS=DCi9X5mmacNGLeJvCw9fdWgX3G8V4QquDn4EuXATkcYr
# PAY_TO_EVM_ADDRESS=0x34cfb8bdbf16e4484b7da0ed31deed5771b16c8f

# Price in USD for paid endpoints (must be between 0.01 and 1.00)
PRICE_USD=0.01
# Single-premium implied vol (default $0.03)
PRICE_IMPLIED_VOL_USD=0.03
# IV surface endpoint (typically higher than single-option)
PRICE_VOL_SURFACE_USD=0.10
# Portfolio net Greeks (default $0.15)
PRICE_PORTFOLIO_GREEKS_USD=0.15
# Portfolio scenario reprice (default $0.25)
PRICE_PORTFOLIO_SCENARIO_USD=0.25
# Price options on a submitted IV surface (default $0.08)
PRICE_OPTION_FROM_SURFACE_USD=0.08
# Scenario reval on IV surface (default $0.15)
PRICE_SCENARIO_FROM_SURFACE_USD=0.15
# Max options per invert-surface request (1–500, default 200)
MAX_SURFACE_OPTIONS=200
# Max (k,T,iv) points on pricing surfaces (1–500, default 200)
MAX_SURFACE_POINTS=200
# Max options/legs on price-from-surface / scenario-from-surface (default 50)
MAX_SURFACE_PRICE_OPTIONS=50
# Max positions per portfolio request (1–500, default 100)
MAX_PORTFOLIO_POSITIONS=100
# Max scenarios per portfolio scenario request (1–100, default 20)
MAX_SCENARIOS=20

# Comma-separated networks (402 accepts one entry per network):
#   base-sepolia | base | solana | solana-devnet
# Aliases: solana-mainnet, base-mainnet, etc.
#
# Recommended production (TWO facilitators — not one URL):
#   NETWORKS=solana,base
#   FACILITATOR_URL=https://facilitator.payai.network   # PayAI only (Solana)
#   PAY_TO_ADDRESS=<Solana base58>
#   PAY_TO_EVM_ADDRESS=0x34cfb8bdbf16e4484b7da0ed31deed5771b16c8f
#   CDP_API_KEY_ID=… / CDP_API_KEY_SECRET=…             # Base via CDP
#
# Testnet only (public facilitator, no auth):
#   NETWORKS=base-sepolia          FACILITATOR_URL=https://x402.org/facilitator
#   NETWORKS=solana-devnet         FACILITATOR_URL=https://x402.org/facilitator
NETWORKS=solana,base

# PayAI facilitator — Solana mainnet (and Base fallback when CDP is unset).
# Do NOT set this to https://api.cdp.coinbase.com/platform/v2/x402
FACILITATOR_URL=https://facilitator.payai.network

# Coinbase CDP facilitator for Base mainnet (eip155:8453). BOTH keys required.
# When set: Base verify/settle via CDP (JWT on the CDP client only); Solana stays on PayAI.
# When unset: PayAI handles both (if it supports Base for your account).
# Missing keys or CDP 401 → process still listens on Solana/PayAI.
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# Optional; unused when PAY_TO_EVM_ADDRESS is an EOA (not a CDP-managed wallet):
# CDP_WALLET_SECRET=

# Never put buyer private keys on the server. Receiving addresses (payTo) are
# public but must NOT appear on free HTTP responses — only in 402 PAYMENT-REQUIRED.

# Public base URL of this service (service card / discovery). Set to your Railway URL.
PUBLIC_BASE_URL=http://localhost:4021

# CORS origins (comma-separated). Use * only for local dev; set your domain in prod.
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Idempotency cache TTL (milliseconds)
IDEMPOTENCY_TTL_MS=300000

# Set to 1 when running behind a reverse proxy (Railway, nginx, Caddy, load balancer)
TRUST_PROXY=0

# Local/debug ONLY: skip x402 payment gate so handlers return 200 JSON without USDC.
# Rejected when NODE_ENV=production. Never set on Railway.
# SKIP_PAYMENT=1

# ── Free discovery seeding ───────────────────────────────────────────────────
# Fixed ATM sample at GET|POST /v1/demo/option-price (live engine, constant inputs).
# Default on. Set FREE_DEMO_ENABLED=0 to disable.
FREE_DEMO_ENABLED=1
FREE_DEMO_RATE_MAX=30

# Optional first-N free on POST /v1/option/price only (per IP per window).
# 0 = off (default). Example seeding: FREE_TIER_N=5
FREE_TIER_N=0
FREE_TIER_WINDOW_MS=86400000

# ── MCP façade (Streamable HTTP, stateless) ──────────────────────────────────
# Tools: price_option, implied_vol_surface (paid via @x402/mcp), service_info (free)
MCP_ENABLED=1
MCP_PATH=/mcp

# ── Railway / production dual mainnet example (two facilitators) ─────────────
# NODE_ENV=production
# TRUST_PROXY=1
# NETWORKS=solana,base
# PAY_TO_ADDRESS=YourSolanaBase58Address
# PAY_TO_EVM_ADDRESS=0x34cfb8bdbf16e4484b7da0ed31deed5771b16c8f
# FACILITATOR_URL=https://facilitator.payai.network
# CDP_API_KEY_ID=...
# CDP_API_KEY_SECRET=...
# # CDP_WALLET_SECRET=   # optional; unused for EOA payTo
# PRICE_USD=0.01
# PUBLIC_BASE_URL=https://your-service.up.railway.app
# CORS_ORIGIN=https://your-frontend.example.com
# (PORT is injected by Railway — do not hardcode)

# ── Client only (local machine — NEVER set on Railway) ───────────────────────
# Never commit real keys. Fund buyer wallet with USDC on the target network.
# Dual 402: only ONE of these is required (client pays on any offered chain).
# EVM_PRIVATE_KEY=0x...
# SVM_PRIVATE_KEY=...
# SERVER_URL=http://localhost:4021
