# ── Server ──────────────────────────────────────────────────────────────────
PORT=4021
NODE_ENV=development

# Dual mainnet receivers (public addresses only)
# Solana (primary + SVM)
PAY_TO_ADDRESS=DCi9X5mmacNGLeJvCw9fdWgX3G8V4QquDn4EuXATkcYr
PAY_TO_SVM_ADDRESS=DCi9X5mmacNGLeJvCw9fdWgX3G8V4QquDn4EuXATkcYr
# Base mainnet
PAY_TO_EVM_ADDRESS=0x34cfb8bdbf16e4484b7da0ed31deed5771b16c8f

# Price in USD for paid endpoints (must be between 0.01 and 1.00)
PRICE_USD=0.01
PRICE_VOL_SURFACE_USD=0.10
PRICE_IMPLIED_VOL_USD=0.03
PRICE_PORTFOLIO_GREEKS_USD=0.15
PRICE_PORTFOLIO_SCENARIO_USD=0.25
MAX_SURFACE_OPTIONS=200
MAX_PORTFOLIO_POSITIONS=100
MAX_SCENARIOS=20

# Solana mainnet + Base mainnet — 402 offers both (USDC exact via PayAI)
NETWORKS=solana,base
FACILITATOR_URL=https://facilitator.payai.network

# Public base URL of this service (used in discovery / service card)
PUBLIC_BASE_URL=http://localhost:4021

# CORS origins (comma-separated). Use * only for local dev.
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Idempotency cache TTL (milliseconds)
IDEMPOTENCY_TTL_MS=300000

# Set to 1 when running behind a reverse proxy (nginx, Caddy, load balancer)
TRUST_PROXY=0

# ── Client only (clients/test-client.ts) ────────────────────────────────────
# Never commit real keys. Set only in a local shell or a private .env that stays gitignored.
# Dual 402: only one key is required (Solana OR Base).
# EVM_PRIVATE_KEY=0x...
# SVM_PRIVATE_KEY=...
# SERVER_URL=http://localhost:4021
